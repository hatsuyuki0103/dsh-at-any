{
    "name":  "dsh-at-any",
    "description":  "Codex-style @path references for the DeepSeek Harness web GUI: search workspace paths without injecting file content",
    "version":  "0.1.2",
    "license":  "MIT",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./invariant":  {
                                        "types":  "./lib/types/invariant.d.ts",
                                        "default":  "./lib/invariant.js"
                                    },
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-api-session-controller",
                                              "@deepseek-ai/dsh-client-ui-renderer",
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-input-trigger",
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ]
                           }
            },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "dsh.plugin.json",
                  "README.md",
                  "README.zh.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "build":  "node build.mjs",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "check":  "pnpm run typecheck \u0026\u0026 pnpm run test \u0026\u0026 pnpm run build"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1-rc.1",
                             "@deepseek-ai/dsh-agent":  "*",
                             "@deepseek-ai/dsh-typert-protocol":  "*",
                             "@deepseek-ai/dsh-client-runtime":  "*",
                             "@deepseek-ai/dsh-api-remotes":  "*",
                             "@deepseek-ai/dsh-client-ui-input-trigger":  "*",
                             "@deepseek-ai/dsh-client-ui-slots":  "*",
                             "@deepseek-ai/dsh-client-ui-conversation":  "*",
                             "@deepseek-ai/dsh-client-locale":  "*",
                             "@deepseek-ai/dsh-client-connection":  "*",
                             "react":  "^18.2.0",
                             "@deepseek-ai/dsh-typert-registry":  "*",
                             "@deepseek-ai/dsh-settings":  "*",
                             "@deepseek-ai/dsh-client-ui-settings":  "*",
                             "@deepseek-ai/dsh-llm":  "*"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/cordis":  {
                                                             "optional":  true
                                                         },
                                 "@deepseek-ai/dsh-agent":  {
                                                                "optional":  true
                                                            },
                                 "@deepseek-ai/dsh-typert-protocol":  {
                                                                          "optional":  true
                                                                      },
                                 "@deepseek-ai/dsh-client-store":  {
                                                                       "optional":  true
                                                                   },
                                 "@deepseek-ai/dsh-api-session-controller":  {
                                                                                "optional":  true
                                                                            },
                                 "@deepseek-ai/dsh-client-ui-renderer":  {
                                                                            "optional":  true
                                                                        },
                                 "@deepseek-ai/dsh-api-remotes":  {
                                                                      "optional":  true
                                                                  },
                                 "@deepseek-ai/dsh-client-ui-input-trigger":  {
                                                                                  "optional":  true
                                                                              },
                                 "@deepseek-ai/dsh-client-ui-slots":  {
                                                                          "optional":  true
                                                                      },
                                 "@deepseek-ai/dsh-client-ui-conversation":  {
                                                                                 "optional":  true
                                                                             },
                                 "@deepseek-ai/dsh-client-locale":  {
                                                                        "optional":  true
                                                                    },
                                 "@deepseek-ai/dsh-client-connection":  {
                                                                            "optional":  true
                                                                        },
                                 "react":  {
                                               "optional":  true
                                           },
                                 "@deepseek-ai/dsh-typert-registry":  {
                                                                          "optional":  true
                                                                      },
                                 "@deepseek-ai/dsh-settings":  {
                                                                   "optional":  true
                                                               },
                                 "@deepseek-ai/dsh-client-ui-settings":  {
                                                                             "optional":  true
                                                                         },
                                 "@deepseek-ai/dsh-llm":  {
                                                              "optional":  true
                                                          }
                             },
    "dependencies":  {
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.2",
                            "@deepseek-ai/dsh-agent":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-typert-protocol":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-invariants":  "^0.1.2-rc.1",
                            "@deepseek-ai/schemastery":  "^3.18.2",
                            "@deepseek-ai/dsh-client-store":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-api-session-controller":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-ui-renderer":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-session":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-ui-session":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-ui-workspace":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-api-workspace-controller":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-api-gateway":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-api-remotes":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-ui-input-trigger":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-ui-slots":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-ui-conversation":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-locale":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-connection":  "^0.1.2-rc.1",
                            "@types/node":  "^24.0.0",
                            "@types/react":  "^18.2.0",
                            "@types/react-dom":  "^18.2.0",
                            "@vitest/coverage-v8":  "^4.1.8",
                            "esbuild":  "^0.25.0",
                            "jsdom":  "29.1.1",
                            "react":  "^18.2.0",
                            "react-dom":  "^18.2.0",
                            "typescript":  "^6.0.3",
                            "vitest":  "^4.1.8",
                            "@deepseek-ai/dsh-typert-registry":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-settings":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-client-ui-settings":  "^0.1.2-rc.1",
                            "@deepseek-ai/dsh-llm":  "^0.1.2-rc.1"
                        },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/hatsuyuki0103/dsh-at-any.git"
                   },
    "homepage":  "https://github.com/hatsuyuki0103/dsh-at-any#readme",
